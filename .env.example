PORT=3000
# Path to the Firebase service account JSON you download from Firebase Console
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Or set the JSON inline (optional alternative — use this on Render)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
ALLOWED_ORIGINS=*

# Groq (https://console.groq.com) — keep the key on the server only
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Max AI parse requests per identity (uid or IP) per UTC day
AI_DAILY_LIMIT=40
