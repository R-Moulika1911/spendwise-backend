PORT=3000
# Local file path (dev)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Prefer BASE64 on Render (avoids private_key newline corruption)
# FIREBASE_SERVICE_ACCOUNT_BASE64=...
# Or raw JSON one-liner (can break on Render — use BASE64 instead)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
ALLOWED_ORIGINS=*

# Groq (https://console.groq.com) — keep the key on the server only
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Max AI parse requests per identity (uid or IP) per UTC day
AI_DAILY_LIMIT=40
